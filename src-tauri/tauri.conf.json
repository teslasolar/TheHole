{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-config-schema/schema.json",
  "productName": "THE HOLE BROWSER",
  "version": "0.1.0",
  "identifier": "com.thehole.browser",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "THE HOLE BROWSER",
        "width": 1200,
        "height": 800,
        "decorations": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self' hole://* https://*; script-src 'self' 'unsafe-inline' hole://*; style-src 'self' 'unsafe-inline' hole://*; img-src 'self' hole://* https://* data:; connect-src 'self' hole://* https://*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ]
  }
}
